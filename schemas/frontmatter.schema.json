{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/frontmatter.schema.json",
  "title": "YAML Frontmatter Schema",
  "description": "Esquema formal de validación para encabezados YAML Frontmatter en los archivos Markdown del repositorio de Recursos Didácticos.",
  "type": "object",
  "required": [
    "id",
    "name",
    "title",
    "file_path",
    "version",
    "category",
    "tags",
    "description",
    "owner",
    "status",
    "created_at",
    "updated_at",
    "schema_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^([a-z]{2,12}_[0-9a-hjkmnp-tv-z]{26}|[0-9]{2}_[a-z0-9_]{3,60}|[a-z]{3,12}_[a-z0-9_]{3,50})$",
      "description": "Identificador único inmutable (Slug Secuencial Numérico obligatorio ej. 00_agents_contract o TypeID/slug de dominio)"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,64}$",
      "description": "Identificador descriptivo en snake_case coincidente con la convención del archivo"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "description": "Título legible del documento o especificación"
    },
    "file_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_./-]+\\.(md|markdown)$",
      "description": "Ruta POSIX relativa del archivo desde la raíz del repositorio"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Versión semántica SemVer 2.0.0 (MAJOR.MINOR.PATCH)"
    },
    "category": {
      "type": "string",
      "enum": [
        "standards",
        "architecture",
        "agentic",
        "code_standards",
        "metadata",
        "errors",
        "templates",
        "guides",
        "universal_principles",
        "architecture_plan",
        "memory",
        "governance",
        "testing",
        "ci",
        "security",
        "syllabus"
      ],
      "description": "Categoría taxonómica funcional del documento"
    },
    "domain": {
      "type": "string",
      "description": "Subdominio de materia pedagógica (ej. Circuitos, Electromagnetismo, Telecomunicaciones, VHDL, core)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$"
      },
      "minItems": 1,
      "maxItems": 35,
      "description": "Palabras clave en minúsculas para indexación agéntica"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Resumen conciso del alcance y responsabilidad del documento (10-500 caracteres)"
    },
    "author": {
      "type": "string",
      "description": "Autor original del documento"
    },
    "owner": {
      "type": "string",
      "description": "Equipo o rol responsable de la gobernanza del documento"
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de mantenedores activos"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "ready_for_execution",
        "deprecated",
        "archived"
      ],
      "description": "Estado en el ciclo de vida del documento"
    },
    "created_at": {
      "type": "string",
      "description": "Marca temporal de creación en formato ISO 8601 UTC"
    },
    "updated_at": {
      "type": "string",
      "description": "Marca temporal de última modificación en formato ISO 8601 UTC"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Versión del esquema de metadatos"
    },
    "license": {
      "type": "string",
      "description": "Identificador de licencia SPDX (ej. MIT, Apache-2.0)"
    },
    "agent_visibility": {
      "type": "string",
      "enum": ["public", "internal", "restricted"],
      "default": "public"
    },
    "tool_access_level": {
      "type": "string",
      "enum": ["read_only", "safe_mutation", "full_access"],
      "default": "safe_mutation"
    },
    "execution_mode": {
      "type": "string",
      "enum": ["sync", "async", "batch", "event_driven"]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9_]{3,64}|[0-9]{2}_[a-z0-9_]{3,60})$"
      },
      "description": "Lista de IDs de especificaciones o documentos requeridos previamente"
    },
    "parent_doc": {
      "type": "string",
      "description": "Documento padre jerárquico opcional"
    },
    "related_specs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9_]{3,64}|[0-9]{2}_[a-z0-9_]{3,60})$"
      },
      "description": "Lista de IDs de especificaciones o documentos complementarios"
    },
    "entrypoint": {
      "type": "string",
      "description": "Ruta física de ejecución cuando aplica a módulos o tareas"
    }
  },
  "additionalProperties": true
}
